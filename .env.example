# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env to version control

# Rails master key for encrypted credentials
# Get this value from config/master.key
RAILS_MASTER_KEY=your_master_key_here

# Optional: Custom hostname for production
# RAILS_HOSTNAME=your-domain.com

# Optional: Override default port (default is 80 inside container, exposed as 3000)
# PORT=80

# PostgreSQL Configuration (required — services/render and the render listener
# both need a Postgres DB; sqlite is no longer supported in production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=fraktur_ocr_production

# Render pipeline directories. Both Rails and the Go render service mount
# these as shared volumes — the values must match between the two services.
# PDF_ROOT_DIR holds canonical PDFs (one file per Document, named "<id>.pdf").
# RENDER_OUTPUT_DIR receives high-DPI JPEG crops written by the Go renderer.
PDF_ROOT_DIR=/var/lib/fraktur/pdfs
RENDER_OUTPUT_DIR=/var/lib/fraktur/crops

# URL the Go render service uses to call back into Rails after writing a crop.
# In docker-compose this should point at the internal `web` service hostname.
RAILS_BASE_URL=http://localhost:3000

# Shared secret for the /internal/* HTTP callback. Long random string; must
# match the value passed to the render service. Generate with e.g.
#   openssl rand -hex 32
INTERNAL_AUTH_SECRET=change_this_to_a_long_random_string

# BetterStack Logs (Logtail). Create a source in BetterStack → Logs → Sources,
# copy its source token here. Leave empty to ship to local files only.
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_GO_SOURCE_TOKEN=

# Heartbeat URL for the render cleanup cron (BetterStack → Heartbeats).
HEARTBEAT_URL_CLEANUP=

# BetterStack Telemetry (traces). Create a source in BetterStack → Telemetry,
# point OTEL_EXPORTER_OTLP_ENDPOINT at its ingest URL and put the bearer
# token in OTEL_EXPORTER_OTLP_HEADERS. Same values used by Rails (web/worker)
# and the Go renderer; service names are set per-container in compose.
# Leave empty to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# BetterStack Errors (Sentry-compatible). Create an application in
# BetterStack → Errors, copy the DSN value here. Leave empty to disable
# exception reporting.
SENTRY_DSN=

# BetterStack Warehouse (per-page OCR analytics). Create a source in
# BetterStack → Warehouse → Sources, copy its ingest URL and source token
# here. Leave both empty to disable; the metrics column on ocr_requests is
# still populated locally for debugging when only the token is missing.
BETTERSTACK_WAREHOUSE_INGEST_URL=
BETTERSTACK_WAREHOUSE_SOURCE_TOKEN=
# Optional tuning (defaults shown). batch_size: events per HTTP POST.
# flush_interval_seconds: max age of buffered events before flush.
# buffer_max: hard cap; oldest dropped on overflow.
BETTERSTACK_WAREHOUSE_BATCH_SIZE=50
BETTERSTACK_WAREHOUSE_FLUSH_INTERVAL_SECONDS=5
BETTERSTACK_WAREHOUSE_BUFFER_MAX=1000
