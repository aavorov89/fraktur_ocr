<% if ocr_request.nil? %>
  <div class="ocr-state">
    <span class="ocr-state-text"><%= t('ocr.select_region') %></span>
  </div>

<% elsif ocr_request.pending? || ocr_request.processing? %>
  <div class="ocr-state">
    <div class="ocr-spinner"></div>
    <span class="ocr-state-text"><%= t('ocr.recognizing') %></span>
  </div>

<% elsif ocr_request.failed? %>
  <div class="ocr-state">
    <span class="ocr-error">⚠ <%= ocr_request.error_message || t('ocr.failed') %></span>
  </div>

<% elsif ocr_request.completed? %>
  <div class="ocr-content">
    <% if ocr_request.corrected_text.present? %>
      <%# State 1: Corrected text available (normal display) %>
      <div class="ocr-text"><%= ocr_request.corrected_text %></div>
      <button class="copy-btn" data-controller="clipboard" data-clipboard-text-value="<%= ocr_request.corrected_text %>" data-action="clipboard#copy" title="<%= t('ocr.copy_text') %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
        </svg>
      </button>

    <% elsif ocr_request.correction_error.present? %>
      <%# State 2: Correction failed (show warning and raw text) %>
      <div class="ocr-correction-warning">
        <span>⚠</span>
        <span><%= t('ocr.correction_failed') %></span>
      </div>
      <div class="ocr-text"><%= ocr_request.recognized_text %></div>
      <button class="copy-btn" data-controller="clipboard" data-clipboard-text-value="<%= ocr_request.recognized_text %>" data-action="clipboard#copy" title="<%= t('ocr.copy_text') %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
        </svg>
      </button>

    <% else %>
      <%# State 3: Correction in progress (show dimmed raw text with spinner) %>
      <div class="ocr-correction-status">
        <div class="ocr-spinner-small"></div>
        <span><%= t('ocr.correcting') %></span>
      </div>
      <div class="ocr-text ocr-text-dim"><%= ocr_request.recognized_text %></div>
      <button class="copy-btn" data-controller="clipboard" data-clipboard-text-value="<%= ocr_request.recognized_text %>" data-action="clipboard#copy" title="<%= t('ocr.copy_text') %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
        </svg>
      </button>
    <% end %>
  </div>
<% end %>
