<% running = document.translation_running? %>
<%= form_with url: document_translation_path(document), class: "panel-actions" do |f| %>
  <label for="target-language" class="language-label"><%= t('translation.translate_to') %></label>
  <%= f.select :target_language,
        Document::TARGET_LANGUAGES.map { [t("translation.languages.#{_1.downcase}"), _1] },
        { selected: document.target_language }, id: "target-language", class: "language-select" %>
  <%= f.button t('translation.run'), class: "panel-action-btn panel-action-primary", disabled: running %>
<% end %>

<% if running %>
  <div class="ocr-correction-status">
    <span class="ocr-spinner-small"></span><span><%= t('translation.translating') %></span>
  </div>
<% elsif document.translation_failed? %>
  <div class="ocr-correction-warning">
    <span>⚠</span><span><%= document.translation_error || t('translation.failed') %></span>
  </div>
<% end %>

<% if document.translated_text.present? %>
  <div class="ocr-content">
    <div class="ocr-text <%= 'ocr-text-dim' if running %>"><%= document.translated_text %></div>
    <%= render "documents/copy_button", text: document.translated_text, title: t('translation.copy_translation') %>
  </div>
<% elsif !running && !document.translation_failed? %>
  <div class="translation-state">
    <span class="translation-state-text"><%= t('translation.will_appear') %></span>
  </div>
<% end %>
