<% if ocr_request.nil? %>
  <div class="translation-state">
    <span class="translation-state-text">Translation will appear here once text is recognized</span>
  </div>

<% elsif ocr_request.pending? || ocr_request.processing? %>
  <div class="translation-state">
    <span class="translation-state-text">Waiting for text recognition…</span>
  </div>

<% elsif ocr_request.failed? %>
  <div class="translation-state">
    <span class="translation-state-text">OCR failed — no text to translate</span>
  </div>

<% elsif ocr_request.completed? %>
  <% if ocr_request.translated_text.present? %>
    <div class="ocr-content">
      <div class="ocr-text"><%= ocr_request.translated_text %></div>
      <button class="copy-btn" data-controller="clipboard" data-clipboard-text-value="<%= ocr_request.translated_text %>" data-action="clipboard#copy" title="Copy translation">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
        </svg>
      </button>
    </div>
  <% elsif ocr_request.translation_error.present? %>
    <div class="ocr-state">
      <span class="ocr-error">⚠ <%= ocr_request.translation_error %></span>
    </div>
  <% else %>
    <div class="ocr-state">
      <div class="ocr-spinner"></div>
      <span class="ocr-state-text">Translating with DeepL…</span>
    </div>
  <% end %>
<% end %>
