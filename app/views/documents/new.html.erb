<div class="panels">
  <div class="panel panel-pdf">
    <div class="panel-label"><%= t('documents.panels.source_pdf') %></div>
    <div class="pdf-empty">
      <%= form_with model: @document, class: "upload-form", data: { controller: "upload" } do |f| %>
        <label class="upload-area" for="pdf_file_input" data-upload-target="dropzone" data-action="dragover->upload#dragover dragenter->upload#dragover dragleave->upload#dragleave drop->upload#drop">
          <div data-upload-target="prompt">
            <div class="upload-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14,2 14,8 20,8"/>
                <line x1="12" y1="18" x2="12" y2="12"/>
                <polyline points="9,15 12,12 15,15"/>
              </svg>
            </div>
            <span class="upload-text"><%= t('documents.new.upload_text') %></span>
            <span class="upload-hint"><%= t('documents.new.upload_hint') %></span>
          </div>
          <div data-upload-target="progressArea" style="display:none">
            <div class="upload-progress">
              <div class="upload-progress-bar" data-upload-target="progressBar" style="width: 0%"></div>
            </div>
            <span class="upload-progress-text" data-upload-target="progressText">0%</span>
            <span class="upload-hint"><%= t('documents.upload.uploading') %></span>
          </div>
          <input type="file" id="pdf_file_input" accept="application/pdf" hidden
                 data-upload-target="input" data-action="change->upload#fileSelected">
          <%= f.hidden_field :name, data: { upload_target: "name" } %>
        </label>
        <%= f.submit t('documents.new.upload_button'), class: "upload-submit", data: { upload_target: "submit" }, style: "display:none" %>
      <% end %>
    </div>
  </div>

  <div class="divider"></div>

  <div class="panel panel-ocr">
    <div class="panel-label"><%= t('documents.panels.recognized_text') %></div>
    <div id="ocr_panel" class="ocr-state">
      <span class="ocr-state-text"><%= t('ocr.select_region') %></span>
    </div>
  </div>

  <div class="divider"></div>

  <div class="panel panel-translation">
    <div class="panel-label"><%= t('documents.panels.translation') %></div>
    <div id="translation_panel" class="translation-state">
      <span class="translation-state-text"><%= t('translation.will_appear') %></span>
    </div>
  </div>
</div>
