<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('app.name') %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,300;0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", data_turbo_track: "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <header class="app-header">
    <div class="header-left">
      <h1><%= link_to t('app.name'), root_path %></h1>
      <span class="app-subtitle"><%= t('app.subtitle') %></span>
    </div>
    <% if current_user %>
      <div class="header-right">
        <span class="user-name"><%= current_user.name %></span>
        <%= button_to t('header.logout'), logout_path, method: :delete, class: "btn-logout" %>
      </div>
    <% end %>
  </header>

  <%= yield %>
</body>
</html>
