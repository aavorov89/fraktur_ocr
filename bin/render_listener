#!/usr/bin/env ruby
# Long-lived process that bridges Postgres NOTIFY into Active Job: when the
# Go render service finishes a crop, it issues `NOTIFY render_done '<id>'`.
# We catch the payload and enqueue OcrJob to send the crop to Claude.

require_relative "../config/environment"
require "pg"

conn = PG.connect(ENV.fetch("RENDER_DATABASE_URL") { ENV.fetch("DATABASE_URL") })
conn.exec("LISTEN render_done")
Rails.logger.info("[render_listener] listening on render_done")

trap("INT")  { exit 0 }
trap("TERM") { exit 0 }

loop do
  conn.wait_for_notify do |_channel, _pid, payload|
    begin
      OcrJob.perform_later(Integer(payload))
      Rails.logger.info("[render_listener] enqueued OcrJob for #{payload}")
    rescue => e
      Rails.logger.error("[render_listener] error handling #{payload}: #{e.message}")
    end
  end
end
